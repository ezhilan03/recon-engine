DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/reconengine?sslmode=require"
GEMINI_API_KEY="your-gemini-api-key-from-aistudio.google.com"

# Optional: cap how many cases get investigated per run, useful while debugging
# INVESTIGATE_LIMIT=3

# Optional: switch providers without touching code. Defaults to Gemini free tier.
# For local Ollama (after `ollama serve` + `ollama pull qwen3:4b`):
#   INVESTIGATOR_MODEL="ollama_chat/qwen3:4b"
#   PROPOSER_MODEL="ollama_chat/qwen3:4b"
# OLLAMA_API_BASE="http://localhost:11434"  # only needed if not the default
